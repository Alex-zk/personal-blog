---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { BASE } from '../consts';

interface Props { entry: CollectionEntry<'blog'>; }

const { entry } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = entry.data;
const body = entry.body || '';
const readingTime = Math.max(1, Math.ceil(body.length / 400));
---

<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={title} description={description} /></head>
  <body class="min-h-screen flex flex-col bg-bg-soft dark:bg-gray-950">
    <Header />
    <main class="flex-1">
      <article class="max-w-3xl mx-auto px-6 py-12">
        <!-- 文章头部 -->
        <header class="mb-10">
          <div class="flex items-center gap-3 text-sm text-text-soft dark:text-gray-400 mb-4">
            <time>{pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            <span>·</span>
            <span>{readingTime} 分钟阅读</span>
            {updatedDate && <><span>·</span><span>更新于 {updatedDate.toLocaleDateString('zh-CN', { month: 'long', day: 'numeric' })}</span></>}
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-6 leading-tight">{title}</h1>
          {tags && tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {tags.map(tag => (
                <a href={`${BASE}/blog?tag=${tag}`} class="px-3 py-1 text-xs rounded-full bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 text-text-soft dark:text-gray-400 hover:border-accent/40 hover:text-accent transition-all">{tag}</a>
              ))}
            </div>
          )}
        </header>

        <!-- 文章正文 -->
        <div class="prose prose-gray dark:prose-invert prose-lg max-w-none bg-white dark:bg-gray-900 rounded-2xl p-8 sm:p-10 border border-gray-200/60 dark:border-gray-800/60 shadow-sm">
          <slot />
        </div>

        <!-- Giscus 评论 -->
        <div class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-800">
          <h2 class="text-lg font-bold mb-6">💬 讨论</h2>
          <div class="giscus"></div>
          <p class="text-xs text-gray-400 mt-3">加载不出来？去 <a href="https://github.com/Alex-zk/personal-blog/discussions" class="text-accent hover:underline">GitHub Discussions</a> 留言。</p>
        </div>
      </article>
    </main>

    <!-- 返回顶部 -->
    <button id="backToTop" onclick="scrollTo({top:0,behavior:'smooth'})" class="fixed bottom-8 right-8 p-3 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-full shadow-lg opacity-0 invisible transition-all hover:shadow-xl z-50" aria-label="返回顶部">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 15l7-7 7 7"/></svg>
    </button>

    <Footer />
  </body>
</html>

<script>
  // 返回顶部按钮显隐
  const btn = document.getElementById('backToTop');
  addEventListener('scroll', () => {
    if (!btn) return;
    const show = scrollY > 400;
    btn.classList.toggle('opacity-0', !show);
    btn.classList.toggle('invisible', !show);
    btn.classList.toggle('opacity-100', show);
    btn.classList.toggle('visible', show);
  });
  // Giscus
  (() => {
    const c = document.querySelector('.giscus');
    if (!c) return;
    const s = document.createElement('script');
    Object.assign(s, { src: 'https://giscus.app/client.js', crossOrigin: 'anonymous', async: true });
    ['data-repo','data-repo-id','data-category','data-category-id','data-mapping','data-strict','data-reactions-enabled','data-emit-metadata','data-input-position','data-lang','data-loading'].forEach((a,i) => s.setAttribute(a, ['Alex-zk/personal-blog','R_kgDOTgS3Zw','Announcements','DIC_kwDOTgS3Z84Ckz2o','pathname','0','1','0','top','zh-CN','lazy'][i]));
    s.setAttribute('data-theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
    c.appendChild(s);
  })();
</script>
