---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { BASE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title="404 - 页面不存在" description="页面未找到" /></head>
  <body class="min-h-screen flex flex-col bg-bg-soft dark:bg-gray-950">
    <Header />
    <main class="flex-1 flex items-center justify-center px-6">
      <div class="text-center">
        <p class="text-8xl font-extrabold gradient-text mb-4">404</p>
        <h1 class="text-xl font-bold mb-2">页面不存在</h1>
        <p class="text-text-soft dark:text-gray-400 mb-8">你要找的页面可能已被移动或删除。</p>
        <a href={BASE + "/"} class="inline-block px-5 py-2.5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-xl text-sm font-medium hover:opacity-90 transition-all">← 返回首页</a>
      </div>
    </main>
    <Footer />
  </body>
</html>
